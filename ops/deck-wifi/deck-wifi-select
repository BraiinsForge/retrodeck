#!/bin/sh

# Select a known IWD profile only after the Deck has lost complete network
# health. Profile names and credentials are never written to stdout or syslog.

PATH=${DECK_WIFI_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}

PROFILE_DIR=${DECK_WIFI_PROFILE_DIR:-/etc/deck-wifi/profiles}
BACKUP_DIR=${DECK_WIFI_BACKUP_DIR:-/etc/deck-wifi/backups}
PREFERRED_FILE=${DECK_WIFI_PREFERRED_FILE:-${PROFILE_DIR%/*}/preferred}
WIRELESS_CONFIG=${DECK_WIFI_CONFIG:-/etc/config/wireless}
RUNTIME_CONFIG=${DECK_WIFI_RUNTIME_CONFIG:-/var/run/wpa_supplicant-wlan0.conf}
STATUS_FILE=${DECK_WIFI_STATUS_FILE:-/var/run/deck-wifi/status}
IFACE=${DECK_WIFI_INTERFACE:-wlan0}
LOCK_DIR=${DECK_WIFI_LOCK_DIR:-/tmp/deck-wifi-select.lock}
TAB=$(printf '\t')
SCAN_CONFIRMATIONS=${DECK_WIFI_SCAN_CONFIRMATIONS:-3}
SCAN_INTERVAL=${DECK_WIFI_SCAN_INTERVAL:-5}
SCAN_RETRIES=${DECK_WIFI_SCAN_RETRIES:-3}
SCAN_RETRY_INTERVAL=${DECK_WIFI_SCAN_RETRY_INTERVAL:-3}
SWITCH_TIMEOUT=${DECK_WIFI_SWITCH_TIMEOUT:-60}
ROLLBACK_GRACE=${DECK_WIFI_ROLLBACK_GRACE:-20}
HEALTH_INTERVAL=${DECK_WIFI_HEALTH_INTERVAL:-2}
HEALTH_RECOVERY_AFTER=${DECK_WIFI_HEALTH_RECOVERY_AFTER:-20}
ASSOCIATION_TIMEOUT=${DECK_WIFI_ASSOCIATION_TIMEOUT:-15}
CANDIDATE_PASSES=${DECK_WIFI_CANDIDATE_PASSES:-2}
CANDIDATE_PASS_INTERVAL=${DECK_WIFI_CANDIDATE_PASS_INTERVAL:-5}
WIREGUARD_SERVICE=${DECK_WIFI_WIREGUARD_SERVICE:-/etc/init.d/deck-wireguard}
PREFERRED_LIMIT=${DECK_WIFI_PREFERRED_LIMIT:-8}

write_status() {
	status=$1
	status_directory=${STATUS_FILE%/*}
	[ "$status_directory" != "$STATUS_FILE" ] || return 1
	mkdir -p "$status_directory" 2>/dev/null || return 1
	chmod 0700 "$status_directory" 2>/dev/null || true
	current=
	if [ -r "$STATUS_FILE" ]; then
		IFS= read -r current < "$STATUS_FILE" || current=
	fi
	[ "$current" = "$status" ] && return 0
	temporary_status=$STATUS_FILE.tmp.$$
	if printf '%s\n' "$status" > "$temporary_status" &&
		chmod 0600 "$temporary_status" &&
		mv "$temporary_status" "$STATUS_FILE"; then
		logger -t deck-wifi "state: $status"
		return 0
	fi
	rm -f "$temporary_status" 2>/dev/null || true
	return 1
}

mark_recovered() {
	record_success ||
		logger -t deck-wifi 'could not record successful Wi-Fi profile'
	if [ -x "$WIREGUARD_SERVICE" ]; then
		write_status "REFRESHING WIREGUARD" || true
		logger -t deck-wifi 'refreshing WireGuard after network recovery'
		if "$WIREGUARD_SERVICE" restart >/dev/null 2>&1; then
			logger -t deck-wifi 'WireGuard refresh command completed'
		else
			logger -t deck-wifi 'WireGuard refresh command failed'
		fi
	fi
	write_status "CONNECTED" || true
}

secure_files() {
	deck_wifi_root=${PROFILE_DIR%/*}
	chmod 0700 "$deck_wifi_root" "$PROFILE_DIR" "$BACKUP_DIR" 2>/dev/null || true
	chmod 0600 "$WIRELESS_CONFIG" "$RUNTIME_CONFIG" "$STATUS_FILE" \
		"$PREFERRED_FILE" 2>/dev/null || true
	for profile in "$PROFILE_DIR"/*.psk "$PROFILE_DIR"/*.open; do
		[ -f "$profile" ] || continue
		chmod 0600 "$profile" 2>/dev/null || true
	done
}

valid_profile_hex() {
	value=$1
	case "$value" in
		''|*[!0-9a-f]*) return 1 ;;
	esac
	[ "${#value}" -le 64 ] && [ $((${#value} % 2)) -eq 0 ]
}

record_success() {
	[ -n "${STA_SECTION:-}" ] || find_sta_section || return 1
	ssid=$(uci -q get "wireless.${STA_SECTION}.ssid" 2>/dev/null) || return 1
	[ -n "$ssid" ] || return 1
	ssid_hex=$(printf '%s' "$ssid" | xxd -p | tr -d '\n' | tr 'A-F' 'a-f') ||
		return 1
	valid_profile_hex "$ssid_hex" || return 1

	preferred_directory=${PREFERRED_FILE%/*}
	[ "$preferred_directory" != "$PREFERRED_FILE" ] || return 1
	mkdir -p "$preferred_directory" || return 1
	chmod 0700 "$preferred_directory" 2>/dev/null || true
	first=
	if [ -r "$PREFERRED_FILE" ]; then
		IFS= read -r first < "$PREFERRED_FILE" || first=
	fi
	[ "$first" = "$ssid_hex" ] && return 0

	PREFERRED_TEMP=$PREFERRED_FILE.tmp.$$
	if ! {
		printf '%s\n' "$ssid_hex"
		if [ -r "$PREFERRED_FILE" ]; then
			awk -v current="$ssid_hex" -v limit="$PREFERRED_LIMIT" '
				$0 != current && $0 ~ /^[0-9a-f]+$/ &&
				length($0) <= 64 && length($0) % 2 == 0 && !seen[$0]++ &&
				count < limit - 1 { print; count++ }
			' "$PREFERRED_FILE"
		fi
	} > "$PREFERRED_TEMP"; then
		rm -f "$PREFERRED_TEMP" 2>/dev/null || true
		PREFERRED_TEMP=
		return 1
	fi
	chmod 0600 "$PREFERRED_TEMP" || {
		rm -f "$PREFERRED_TEMP" 2>/dev/null || true
		PREFERRED_TEMP=
		return 1
	}
	mv "$PREFERRED_TEMP" "$PREFERRED_FILE" || return 1
	PREFERRED_TEMP=
}

is_associated() {
	iw dev "$IFACE" link 2>/dev/null | grep -q '^Connected to '
}

has_ipv4() {
	ip -4 address show dev "$IFACE" 2>/dev/null |
		awk '$1 == "inet" { found=1 } END { exit !found }'
}

has_default_route() {
	ip -4 route show default 2>/dev/null |
		awk -v iface="$IFACE" '
			{ for (i=1; i<=NF; i++) if ($i == "dev" && $(i+1) == iface) found=1 }
			END { exit !found }
		'
}

network_ready() {
	is_associated && has_ipv4 && has_default_route
}

wait_for_network() {
	timeout=$1
	elapsed=0
	recovery_attempted=false
	association_seen=false
	while [ "$elapsed" -lt "$timeout" ]; do
		network_ready && return 0
		if is_associated; then
			association_seen=true
		elif [ "$association_seen" = false ] &&
			[ "$elapsed" -ge "$ASSOCIATION_TIMEOUT" ]; then
			logger -t deck-wifi \
				'station did not associate within its bounded window'
			return 1
		fi
		if [ "$recovery_attempted" = false ] &&
			[ "$elapsed" -ge "$HEALTH_RECOVERY_AFTER" ] &&
			is_associated; then
			recovery_attempted=true
			if [ -n "${STA_NETWORK:-}" ]; then
				logger -t deck-wifi \
					'association has no complete IP health; renewing station network'
				ifup "$STA_NETWORK" >/dev/null 2>&1 ||
					logger -t deck-wifi 'station network renewal command failed'
			fi
		fi
		sleep "$HEALTH_INTERVAL"
		elapsed=$((elapsed + HEALTH_INTERVAL))
	done
	network_ready
}

find_sta_section() {
	STA_SECTION=
	STA_NETWORK=
	index=0
	while uci -q get "wireless.@wifi-iface[$index]" >/dev/null 2>&1; do
		mode=$(uci -q get "wireless.@wifi-iface[$index].mode" 2>/dev/null)
		disabled=$(uci -q get "wireless.@wifi-iface[$index].disabled" 2>/dev/null)
		if [ "$mode" = sta ] && [ "${disabled:-0}" != 1 ]; then
			STA_SECTION="@wifi-iface[$index]"
			STA_NETWORK=$(uci -q get \
				"wireless.@wifi-iface[$index].network" 2>/dev/null)
			case "$STA_NETWORK" in
				''|*[!A-Za-z0-9_-]*) STA_NETWORK= ;;
			esac
			return 0
		fi
		index=$((index + 1))
	done
	return 1
}

profile_stem() {
	profile_name=${1##*/}
	case "$profile_name" in
		*.psk) printf '%s\n' "${profile_name%.psk}" ;;
		*.open) printf '%s\n' "${profile_name%.open}" ;;
		*) return 1 ;;
	esac
}

profile_kind() {
	case "${1##*/}" in
		*.psk) printf '%s\n' psk ;;
		*.open) printf '%s\n' open ;;
		*) return 1 ;;
	esac
}

profile_hex() {
	profile_name=$(profile_stem "$1") || return 1
	case "$profile_name" in
		=*) printf '%s\n' "${profile_name#=}" | tr 'A-F' 'a-f' ;;
		*) printf '%s' "$profile_name" | xxd -p | tr -d '\n'; printf '\n' ;;
	esac
}

profile_enabled() {
	profile=$1
	value=$(awk -F= '$1 == "AutoConnect" { value=$2 } END { print value }' \
		< "$profile" 2>/dev/null) || return 1
	[ "$value" != false ]
}

find_enabled_profile() {
	wanted_hex=$1
	wanted_encryption=$2
	SELECTED_PROFILE=
	for profile in "$PROFILE_DIR"/*.psk "$PROFILE_DIR"/*.open; do
		[ -f "$profile" ] || continue
		case "$wanted_encryption:$(profile_kind "$profile")" in
			none:open|psk:psk|psk2:psk|psk-mixed:psk|sae:psk|sae-mixed:psk) ;;
			*) continue ;;
		esac
		profile_enabled "$profile" || continue
		candidate_hex=$(profile_hex "$profile") || continue
		valid_profile_hex "$candidate_hex" || continue
		[ "$candidate_hex" = "$wanted_hex" ] || continue
		SELECTED_PROFILE=$profile
		return 0
	done
	return 1
}

load_profile_key() {
	profile=$1
	SELECTED_KEY=
	SELECTED_RAW_PSK=false
	if [ "$(profile_kind "$profile")" = open ]; then
		return 0
	fi
	SELECTED_KEY=$(awk -F= '
		$1 == "Passphrase" { sub(/^[^=]*=/, ""); print; found=1; exit }
		END { if (!found) exit 1 }
	' < "$profile" 2>/dev/null) || SELECTED_KEY=
	if [ -n "$SELECTED_KEY" ]; then
		key_length=${#SELECTED_KEY}
		[ "$key_length" -ge 8 ] && [ "$key_length" -le 63 ] || return 1
		return 0
	fi
	SELECTED_KEY=$(awk -F= '
		$1 == "PreSharedKey" { sub(/^[^=]*=/, ""); print; found=1; exit }
		END { if (!found) exit 1 }
	' < "$profile" 2>/dev/null) || SELECTED_KEY=
	[ "${#SELECTED_KEY}" -eq 64 ] || return 1
	case "$SELECTED_KEY" in
		*[!0-9A-Fa-f]*) return 1 ;;
	esac
	SELECTED_RAW_PSK=true
	return 0
}

profile_ssid() {
	profile_name=$(profile_stem "$1") || return 1
	case "$profile_name" in
		=*)
			encoded=${profile_name#=}
			valid_profile_hex "$(printf '%s' "$encoded" | tr 'A-F' 'a-f')" || return 1
			printf '%s' "$encoded" | xxd -r -p
			;;
		*) printf '%s' "$profile_name" ;;
	esac
}

cleanup() {
	[ -n "${SCAN_DIR:-}" ] && rm -rf "$SCAN_DIR" 2>/dev/null || true
	[ -n "${UCI_WORK:-}" ] && rm -rf "$UCI_WORK" 2>/dev/null || true
	[ -n "${RESTORE_WORK:-}" ] && rm -f "$RESTORE_WORK" 2>/dev/null || true
	rmdir "$LOCK_DIR" 2>/dev/null || true
}

parse_iwinfo_scan() {
	awk '
		function classify(line, lower, has_psk, has_sae, has_wpa, has_wpa2) {
			lower=tolower(line)
			if (index(lower, "none")) return "none"
			has_psk=index(lower, "psk") > 0
			has_sae=index(lower, "sae") > 0
			has_wpa=lower ~ /(^|[^a-z0-9])wpa([^0-9]|$)/
			has_wpa2=index(lower, "wpa2") > 0
			if (has_sae && has_psk) return "sae-mixed"
			if (has_sae) return "sae"
			if (has_psk && has_wpa && has_wpa2) return "psk-mixed"
			if (has_psk && has_wpa2) return "psk2"
			if (has_psk && has_wpa) return "psk"
			return "unsupported"
		}
		function emit() {
			if (length(ssid) > 0) printf "%s\t%s\t%s\n", signal, encryption, ssid
		}
		/^Cell / {
			emit()
			signal=-1000
			ssid=""
			encryption="unsupported"
			next
		}
		/^[[:space:]]*Signal:/ { signal=$2; next }
		/^[[:space:]]*Encryption:/ { encryption=classify($0); next }
		/^[[:space:]]*ESSID: "/ {
			ssid=$0
			sub(/^[[:space:]]*ESSID: "/, "", ssid)
			sub(/"$/, "", ssid)
			next
		}
		END { emit() }
	' "$SCAN_IW" > "$SCAN_RAW"
}

parse_iw_scan() {
	awk '
		function security() {
			if (sae && psk) return "sae-mixed"
			if (sae) return "sae"
			if (psk && wpa && rsn) return "psk-mixed"
			if (psk && rsn) return "psk2"
			if (psk && wpa) return "psk"
			if (capability_seen && !privacy && !wpa && !rsn) return "none"
			return "unsupported"
		}
		function emit() {
			if (length(ssid) > 0) printf "%s\t%s\t%s\n", signal, security(), ssid
		}
		/^BSS / {
			emit()
			signal=-1000
			ssid=""
			capability_seen=0
			privacy=0
			wpa=0
			rsn=0
			psk=0
			sae=0
			next
		}
		/^[[:space:]]*signal:/ { signal=$2; next }
		/^[[:space:]]*capability:/ {
			capability_seen=1
			if (index($0, "Privacy")) privacy=1
			next
		}
		/^[[:space:]]*WPA:/ { wpa=1; next }
		/^[[:space:]]*RSN:/ { rsn=1; next }
		/Authentication suites:/ {
			if (index($0, "PSK")) psk=1
			if (index($0, "SAE")) sae=1
			next
		}
		/^[[:space:]]*SSID:/ {
			ssid=$0
			sub(/^[[:space:]]*SSID: /, "", ssid)
			next
		}
		END { emit() }
	' "$SCAN_IW" > "$SCAN_RAW"
}

scan_once() {
	: > "$SCAN_IW"
	: > "$SCAN_RAW"
	: > "$SCAN_HEX"
	: > "$SCAN_SORTED"

	if command -v iwinfo >/dev/null 2>&1 &&
		iwinfo "$IFACE" scan > "$SCAN_IW" 2>/dev/null; then
		parse_iwinfo_scan
	fi
	if [ ! -s "$SCAN_RAW" ]; then
		: > "$SCAN_IW"
		if ! iw dev "$IFACE" scan > "$SCAN_IW" 2>/dev/null; then
			return 1
		fi
		parse_iw_scan
	fi
	[ -s "$SCAN_RAW" ] || return 1

	while IFS="$TAB" read -r signal encryption ssid; do
		ssid_hex=$(printf '%s' "$ssid" | xxd -p | tr -d '\n' | tr 'A-F' 'a-f')
		valid_profile_hex "$ssid_hex" || continue
		printf '%s\t%s\t%s\n' "$signal" "$encryption" "$ssid_hex"
	done < "$SCAN_RAW" > "$SCAN_HEX"
	sort -rn -k1,1 "$SCAN_HEX" > "$SCAN_SORTED"
	[ -s "$SCAN_SORTED" ]
}

candidate_already_added() {
	wanted_hex=$1
	awk -F "$TAB" -v wanted="$wanted_hex" '
		$1 == wanted { found=1 }
		END { exit !found }
	' "$CANDIDATES" "$CURRENT_CANDIDATE" 2>/dev/null
}

build_candidate_list() {
	: > "$CANDIDATES"
	: > "$CURRENT_CANDIDATE"
	while IFS="$TAB" read -r _signal encryption candidate_hex; do
		case "$encryption" in
			none|psk|psk2|psk-mixed|sae|sae-mixed) ;;
			*) continue ;;
		esac
		find_enabled_profile "$candidate_hex" "$encryption" || continue
		load_profile_key "$SELECTED_PROFILE" || continue
		if candidate_already_added "$candidate_hex"; then
			continue
		fi
		if [ -n "$current_hex" ] && [ "$candidate_hex" = "$current_hex" ]; then
			printf '%s\t%s\t%s\n' "$candidate_hex" "$SELECTED_PROFILE" \
				"$encryption" >> "$CURRENT_CANDIDATE"
		else
			printf '%s\t%s\t%s\n' "$candidate_hex" "$SELECTED_PROFILE" \
				"$encryption" >> "$CANDIDATES"
		fi
	done < "$SCAN_SORTED"

	# A scan is only a hint. Drivers and busy access points can omit an SSID
	# from every result even though a directed association succeeds. Keep
	# scan-ranked candidates first, then append every other usable saved profile.
	# A passphrase profile uses SAE/WPA2 transition mode as the safe directed
	# fallback; a raw 64-digit PSK cannot be used for SAE and remains WPA2-only.
	for profile in "$PROFILE_DIR"/*.psk "$PROFILE_DIR"/*.open; do
		[ -f "$profile" ] || continue
		profile_enabled "$profile" || continue
		load_profile_key "$profile" || continue
		candidate_hex=$(profile_hex "$profile") || continue
		valid_profile_hex "$candidate_hex" || continue
		if candidate_already_added "$candidate_hex"; then
			continue
		fi
		if [ "$(profile_kind "$profile")" = open ]; then
			encryption=none
		elif [ "$SELECTED_RAW_PSK" = true ]; then
			encryption=psk2
		else
			encryption=sae-mixed
		fi
		if [ -n "$current_hex" ] && [ "$candidate_hex" = "$current_hex" ]; then
			printf '%s\t%s\t%s\n' "$candidate_hex" "$profile" \
				"$encryption" >> "$CURRENT_CANDIDATE"
		else
			printf '%s\t%s\t%s\n' "$candidate_hex" "$profile" \
				"$encryption" >> "$CANDIDATES"
		fi
	done

	: > "$PREFERRED_CANDIDATES"
	if [ -r "$PREFERRED_FILE" ]; then
		while IFS= read -r preferred_hex; do
			valid_profile_hex "$preferred_hex" || continue
			[ "$preferred_hex" != "$current_hex" ] || continue
			if awk -F "$TAB" -v wanted="$preferred_hex" '
				$1 == wanted { print; found=1; exit }
				END { exit !found }
			' "$CANDIDATES" >> "$PREFERRED_CANDIDATES"; then
				awk -F "$TAB" -v wanted="$preferred_hex" \
					'$1 != wanted' "$CANDIDATES" > "$SCAN_RAW"
				mv "$SCAN_RAW" "$CANDIDATES"
			fi
		done < "$PREFERRED_FILE"
	fi

	# Try the configured last-successful SSID first, then recent successes and
	# networks explicitly added by the user, then scan-ranked alternatives.
	cat "$CURRENT_CANDIDATE" "$PREFERRED_CANDIDATES" "$CANDIDATES" \
		> "$SCAN_RAW"
	mv "$SCAN_RAW" "$CANDIDATES"
}

append_uci_set() {
	path=$1
	value=$2
	batch=$3
	{
		printf 'set %s=' "$path"
		printf "'"
		printf '%s' "$value" | sed "s/'/'\\\\''/g"
		printf "'\n"
	} >> "$batch"
}

apply_profile() {
	profile=$1
	encryption=$2
	case "$encryption" in
		none|psk|psk2|psk-mixed|sae|sae-mixed) ;;
		*) return 1 ;;
	esac
	selected_ssid=$(profile_ssid "$profile") || return 1
	load_profile_key "$profile" || return 1
	[ -n "$selected_ssid" ] || return 1

	UCI_WORK=$BACKUP_DIR/.uci.$$
	rm -rf "$UCI_WORK" 2>/dev/null || true
	mkdir "$UCI_WORK" || return 1
	chmod 0700 "$UCI_WORK" || return 1
	cp "$backup" "$UCI_WORK/wireless" || return 1
	chmod 0600 "$UCI_WORK/wireless" || return 1
	UCI_BATCH=$UCI_WORK/batch
	: > "$UCI_BATCH" || return 1
	chmod 0600 "$UCI_BATCH" || return 1
	append_uci_set "wireless.${STA_SECTION}.ssid" "$selected_ssid" \
		"$UCI_BATCH" || return 1
	if [ "$encryption" = none ]; then
		printf 'delete wireless.%s.key\n' "$STA_SECTION" >> "$UCI_BATCH" || return 1
	else
		append_uci_set "wireless.${STA_SECTION}.key" "$SELECTED_KEY" \
			"$UCI_BATCH" || return 1
	fi
	append_uci_set "wireless.${STA_SECTION}.encryption" "$encryption" \
		"$UCI_BATCH" || return 1
	append_uci_set "wireless.${STA_SECTION}.disabled" 0 "$UCI_BATCH" || return 1
	uci -c "$UCI_WORK" -q batch < "$UCI_BATCH" >/dev/null 2>&1 || return 1
	rm -f "$UCI_BATCH"
	UCI_BATCH=
	uci -c "$UCI_WORK" -q commit wireless || return 1
	chmod 0600 "$UCI_WORK/wireless"
	mv "$UCI_WORK/wireless" "$WIRELESS_CONFIG" || return 1
	rmdir "$UCI_WORK"
	UCI_WORK=
	chmod 0600 "$WIRELESS_CONFIG"
	wifi reload >/dev/null 2>&1 || true
	sleep 2
	secure_files
}

restore_wireless_config() {
	RESTORE_WORK=$BACKUP_DIR/.wireless-restore.$$
	cp "$backup" "$RESTORE_WORK" || return 1
	chmod 0600 "$RESTORE_WORK" || return 1
	mv "$RESTORE_WORK" "$WIRELESS_CONFIG" || return 1
	RESTORE_WORK=
	chmod 0600 "$WIRELESS_CONFIG"
	wifi reload >/dev/null 2>&1 || true
	sleep 2
	secure_files
}

umask 077
mkdir "$LOCK_DIR" 2>/dev/null || exit 0
trap cleanup EXIT INT TERM

secure_files
case "${1:-}" in
	--secure-only) exit 0 ;;
	--health-check) network_ready ; exit $? ;;
	--record-success)
		network_ready || exit 1
		find_sta_section || exit 1
		record_success
		exit $?
		;;
	"") ;;
	*) exit 2 ;;
esac

if network_ready; then
	write_status "CONNECTED" || true
	exit 0
fi
[ -d "$PROFILE_DIR" ] || {
	write_status "NO SAVED WIFI PROFILES" || true
	exit 1
}
find_sta_section || {
	write_status "NO ENABLED WIFI STATION" || true
	exit 1
}

TMP_ROOT=${DECK_WIFI_TMP_DIR:-/tmp}
SCAN_DIR=$(mktemp -d "$TMP_ROOT/deck-wifi-select.XXXXXX") || {
	write_status "WIFI TEMP DIRECTORY FAILED" || true
	exit 1
}
chmod 0700 "$SCAN_DIR" || exit 1
SCAN_IW=$SCAN_DIR/scan-iw
SCAN_RAW=$SCAN_DIR/scan-raw
SCAN_HEX=$SCAN_DIR/scan-hex
SCAN_ALL=$SCAN_DIR/scan-all
SCAN_SORTED=$SCAN_DIR/scan-sorted
CANDIDATES=$SCAN_DIR/candidates
CURRENT_CANDIDATE=$SCAN_DIR/current
PREFERRED_CANDIDATES=$SCAN_DIR/preferred

current_ssid=$(uci -q get "wireless.${STA_SECTION}.ssid" 2>/dev/null)
if [ -n "$current_ssid" ]; then
	current_hex=$(printf '%s' "$current_ssid" | xxd -p | tr -d '\n' | tr 'A-F' 'a-f')
else
	current_hex=
fi

: > "$SCAN_ALL"
write_status "SCANNING KNOWN WIFI" || true
confirmation=0
successful_scans=0
while [ "$confirmation" -lt "$SCAN_CONFIRMATIONS" ]; do
	if network_ready; then
		mark_recovered
		exit 0
	fi
	retry=0
	scan_succeeded=false
	write_status "WIFI SCAN $((confirmation + 1)) OF $SCAN_CONFIRMATIONS" || true
	while [ "$retry" -lt "$SCAN_RETRIES" ]; do
		if scan_once; then
			scan_succeeded=true
			cat "$SCAN_HEX" >> "$SCAN_ALL"
			successful_scans=$((successful_scans + 1))
			break
		fi
		retry=$((retry + 1))
		[ "$retry" -ge "$SCAN_RETRIES" ] && break
		write_status "WIFI SCAN RETRY $retry OF $SCAN_RETRIES" || true
		sleep "$SCAN_RETRY_INTERVAL"
		if network_ready; then
			mark_recovered
			exit 0
		fi
	done
	[ "$scan_succeeded" = true ] ||
		logger -t deck-wifi \
			"wifi scan round $((confirmation + 1)) of $SCAN_CONFIRMATIONS failed"
	confirmation=$((confirmation + 1))
	[ "$confirmation" -ge "$SCAN_CONFIRMATIONS" ] || sleep "$SCAN_INTERVAL"
done

if [ "$successful_scans" -eq 0 ]; then
	write_status "WIFI SCAN FAILED TRYING SAVED WIFI" || true
	: > "$SCAN_SORTED"
else
	sort -rn -k1,1 "$SCAN_ALL" > "$SCAN_SORTED"
fi

build_candidate_list
candidate_count=$(wc -l < "$CANDIDATES" 2>/dev/null) || candidate_count=0
case "$candidate_count" in
	''|*[!0-9]*) candidate_count=0 ;;
esac
if [ "$candidate_count" -eq 0 ]; then
	write_status "NO USABLE SAVED WIFI" || true
	exit 1
fi

if network_ready; then
	mark_recovered
	exit 0
fi

mkdir -p "$BACKUP_DIR"
chmod 0700 "$BACKUP_DIR"
stamp=$(date +%Y%m%d-%H%M%S)
backup=$BACKUP_DIR/wireless.${stamp}.$$.before-switch
cp -p "$WIRELESS_CONFIG" "$backup" || {
	write_status "WIFI BACKUP FAILED" || true
	exit 1
}
chmod 0600 "$backup"

candidate_pass=0
while [ "$candidate_pass" -lt "$CANDIDATE_PASSES" ]; do
	candidate_pass=$((candidate_pass + 1))
	attempt=0
	while IFS="$TAB" read -r _candidate_hex candidate_profile candidate_encryption; do
		attempt=$((attempt + 1))
		if network_ready; then
			mark_recovered
			exit 0
		fi
		write_status \
			"WIFI PASS $candidate_pass OF $CANDIDATE_PASSES NETWORK $attempt OF $candidate_count" || true
		logger -t deck-wifi \
			"trying known Wi-Fi profile $attempt of $candidate_count on pass $candidate_pass of $CANDIDATE_PASSES"
		if ! apply_profile "$candidate_profile" "$candidate_encryption"; then
			logger -t deck-wifi \
				"could not apply known Wi-Fi profile $attempt on pass $candidate_pass"
			continue
		fi
		if wait_for_network "$SWITCH_TIMEOUT"; then
			logger -t deck-wifi \
				"known Wi-Fi profile $attempt reached complete network health on pass $candidate_pass"
			mark_recovered
			exit 0
		fi
		associated=no
		ipv4=no
		default_route=no
		is_associated && associated=yes
		has_ipv4 && ipv4=yes
		has_default_route && default_route=yes
		logger -t deck-wifi \
			"known Wi-Fi profile $attempt failed pass $candidate_pass health: associated=$associated ipv4=$ipv4 default-route=$default_route"
	done < "$CANDIDATES"
	[ "$candidate_pass" -ge "$CANDIDATE_PASSES" ] ||
		sleep "$CANDIDATE_PASS_INTERVAL"
done

write_status "RESTORING PREVIOUS WIFI" || true
logger -t deck-wifi 'all saved Wi-Fi profiles failed; restoring previous wireless config'
if ! restore_wireless_config; then
	write_status "WIFI RESTORE FAILED" || true
	logger -t deck-wifi 'failed to restore previous wireless config'
	exit 1
fi
if wait_for_network "$ROLLBACK_GRACE"; then
	logger -t deck-wifi 'previous wireless config recovered complete network health'
	mark_recovered
	exit 0
fi

write_status "NO KNOWN WIFI CONNECTED" || true
logger -t deck-wifi 'no known Wi-Fi reached complete network health'
exit 1
