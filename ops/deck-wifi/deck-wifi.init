#!/bin/sh /etc/rc.common

# OpenWrt rc.common reads these service declarations.
# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/deck-wifi-watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
