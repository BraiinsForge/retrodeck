#!/bin/sh

set -eu
# BMC can launch through a merged-profile symlink. Resolve the package, not
# the profile directory, so an upgrade cannot mix binaries and resources.
entry=$(readlink -f "$0")
bin=${entry%/*}
RETRO_DECK_WIDGET_ROOT=${bin%/*}
export RETRO_DECK_WIDGET_ROOT
exec "$RETRO_DECK_WIDGET_ROOT/libexec/deck-menu-launcher"
