(load "@startup@" :verbose nil :print nil)

(in-package #:retrodeck)

(defmacro check (condition control &rest arguments)
  `(unless ,condition
     (error ,control ,@arguments)))

(defmacro signals-p (condition &body body)
  `(handler-case (progn ,@body nil)
     (,condition () t)))

(defun check-native-state-file (path expected control)
  (multiple-value-bind (value present-p) (read-native-state-file path)
    (check (if expected
               (and present-p (string= value expected))
               (not (or value present-p)))
           control)))

(defun terminal-fixture-plan (&optional
                              (executable "@terminal_fixture@")
                              (arguments '("shell")))
  (list :executable executable :arguments arguments
        :environment '(("RETRO_DECK_KEYMAP" . "cz")) :label "terminal"
        :touch-supervision t :mirror-console t))

(defun main ()
  (check (= (retrodeck.native:abi-version) 28) "Native ABI mismatch")
  (check (zerop (retrodeck.native:process-shutdown-p))
         "Native shutdown state was set")
  (let ((first (monotonic-nanoseconds)))
    (check (and (typep first '(integer 0 *))
                (>= (monotonic-nanoseconds) first))
           "Native monotonic clock failed"))
  (check (= (retrodeck.native:play-tone-sequence
             '((784 35) (1047 40) (1319 55)) 42) 1)
         "Valid three-note cue did not start")
  (retrodeck.native:stop-audio)
  (check (zerop (retrodeck.native:play-tone-sequence
                 '((784 35) (1047 40) (1319 55)) 0))
         "Invalid-volume three-note cue unexpectedly started")
  (check (zerop (retrodeck.native:play-tone-sequence
                 '((784 35) (1047 40) (1319 55) (1568 60)) 42))
         "Four-note cue unexpectedly started")
  (check (zerop (retrodeck.native:chiptune-audio-open 101))
         "Invalid chiptune volume unexpectedly opened audio")
  (check (zerop (retrodeck.native:chiptune-audio-write
                 (coerce "short" 'base-string)))
         "Short chiptune PCM unexpectedly queued")
  (check (= (retrodeck.native:chiptune-audio-close) 1)
         "Chiptune audio close failed")
  (dolist (open (list #'retrodeck.native:wayland-open-widget-at
                      #'retrodeck.native:wayland-open-gameplay-at))
    (dolist (display (list "retrodeck-no-wayland-smoke"
                           "/tmp/retrodeck-no-wayland-smoke"
                           (coerce (list #\x (code-char 0)) 'base-string)))
      (check (zerop (funcall open (coerce display 'base-string)))
             "Invalid Wayland display unexpectedly opened")))
  (let ((runtime (make-dashboard-runtime :auto-presentation t)))
    (check (and (getf runtime :auto-presentation)
                (string= (getf runtime :wayland-display) "retrodeck-smoke")
                (dashboard-runtime-wayland-requested-p runtime)
                (not (getf runtime :wayland)))
           "Automatic presentation environment snapshot diverged"))
  (let ((runtime (make-ten-seconds-runtime :presentation "layer-shell")))
    (check (and (null (getf runtime :volume)) (getf runtime :dirty)
                (getf runtime :wayland) (not (getf runtime :auto-presentation))
                (string= (getf runtime :wayland-display) "retrodeck-smoke")
                (eq (getf runtime :clock) #'monotonic-nanoseconds)
                (zerop (ten-seconds-runtime-volume)))
           "10 Seconds candidate runtime construction diverged"))
  (dolist (fixture '((nil "retrodeck-smoke")
                     ("widget" "retrodeck-smoke")
                     ("layer-shell" "")))
    (check (not (getf (make-ten-seconds-runtime
                       :presentation (first fixture)
                       :wayland-display (second fixture)) :wayland))
           "10 Seconds candidate presentation selector diverged"))
  (let ((runtime (make-dashboard-runtime
                  :auto-presentation t :wayland-display "")))
    (check (not (dashboard-runtime-wayland-requested-p runtime))
           "Explicit empty Wayland display requested Wayland"))
  (check (signals-p error
           (make-dashboard-runtime :wayland nil :auto-presentation t)) "Explicit presentation conflicted silently with automatic mode")
  (multiple-value-bind
        (state runtime palette palette-loaded-p credits-loaded-p)
      (load-dashboard-candidate-session
       "@games@" "@palette@" :credits-path "@credits@")
    (let ((games (getf state :games))
          (crawl (getf state :credits-crawl)))
      (check (and palette-loaded-p credits-loaded-p
                  (= (length games) 21) (= (length palette) 22)
                  (string= (getf (first games) :id) "mario")
                  (string= (getf (nth 13 games) :id) "ten-seconds")
                  (string= (getf (nth 14 games) :id) "lua-repl")
                  (string= (getf (car (last games)) :id) "reboot")
                  (= (length (getf crawl :static-lines)) 30)
                  (plusp (getf crawl :content-height))
                  (getf state :reduced-motion)
                  (getf runtime :auto-presentation)
                  (string= (getf runtime :wayland-display) "retrodeck-smoke")
                  (dashboard-runtime-wayland-requested-p runtime)
                  (not (getf runtime :wayland)))
             "Checked-in candidate dashboard session diverged")))
  (let ((*error-output* (make-broadcast-stream)))
    (multiple-value-bind
          (state runtime palette palette-loaded-p credits-loaded-p)
        (load-dashboard-candidate-session
         "@games@" "@palette@"
         :credits-path "/no/such/retrodeck-credits.tsv")
      (declare (ignore runtime palette))
      (let ((crawl (getf state :credits-crawl)))
        (check (and palette-loaded-p (not credits-loaded-p)
                    (= (length (getf state :games)) 21)
                    (null (getf crawl :lines))
                    (null (getf crawl :static-lines))
                    (zerop (getf crawl :content-height)))
               "Candidate dashboard credits fallback diverged"))))
  (let ((games (load-dashboard-games "@combined_games@")))
    (check (and (= (length games) 1)
                (string= (getf (first games) :id) "upload-one")
                (string= (getf (first games) :title) "?lu?")
                (string= (getf (first games) :rom) "/missing/upload.gb"))
           "Combined UTF-8 dashboard manifest diverged"))
  (check (signals-p error
           (load-dashboard-games "@invalid_games@")) "Invalid dashboard manifest UTF-8 was accepted")
  (let ((*error-output* (make-broadcast-stream)))
    (multiple-value-bind (games palette loaded-p)
        (load-dashboard-bootstrap "@games@" "/no/such/retrodeck-palette.tsv")
      (check (and (not loaded-p) (= (length games) 21)
                  (equal palette *dashboard-palette*))
             "Dashboard palette fallback diverged")))
  (let ((request (format nil "test net~%secret!9~%")))
    (dolist (fixture '(("@helper_fixture@" (0 0 -1 nil) "success")
                       ("@helper_failure_fixture@" (0 7 -1 nil) "exit status 7")
                       ("@helper_signal_fixture@" (0 -1 15 nil) "signal 15")))
      (destructuring-bind (helper expected label) fixture
        (check (equal (retrodeck.native:run-helper
                       (native-path-string helper) (coerce request 'base-string))
                      expected)
               "Helper callback did not report ~A" label)))
    (check (string= (read-native-control-file "@helper_capture@") request)
           "Helper callback changed the exact stdin bytes")
    (let ((result
            (retrodeck.native:run-helper
             (native-path-string "@helper_reject_fixture@")
             (make-array (* 1024 1024) :element-type 'base-char
                         :initial-element #\x))))
      (check (and (equal (subseq result 0 3) '(2 7 -1))
                  (stringp (fourth result)))
             "Helper callback lost input-failure precedence")))
  (labels ((exercise-wifi-helper (helper succeeded-p expected-status
                                  expected-passphrase)
             (let* ((*dashboard-wifi-paths* (copy-list *dashboard-wifi-paths*))
                    (wifi (wifi-initial-state
                           :ssid "test net" :passphrase "secret!9"))
                    (plan (progn
                            (setf (getf *dashboard-wifi-paths* :profile-helper)
                                  helper)
                            (wifi-save-plan wifi)))
                    (state (dashboard-loop-initial-state nil :wifi-state wifi))
                    (runtime (make-dashboard-runtime)))
               (setf (getf state :pending-wifi-plan) plan)
               (let ((completion
                       (dashboard-runtime-handle-effect
                        runtime (list :wifi-action plan) state)))
                 (unless (equal completion
                                (list :wifi-result :succeeded-p succeeded-p))
                   (error "Wi-Fi helper completion was classified incorrectly"))
                 (multiple-value-bind (next effects)
                     (dashboard-reduce state completion)
                   (unless (and
                            (string= (getf (getf next :wifi) :status)
                                     expected-status)
                            (string= (getf (getf next :wifi) :passphrase)
                                     expected-passphrase)
                            (null (getf next :pending-wifi-plan))
                            (equal effects
                                   '((:render) (:cue :confirm) (:present))))
                     (error "Wi-Fi helper runtime completion diverged")))))))
    (exercise-wifi-helper
     "@helper_fixture@" t
     "WIFI SAVED - USED AFTER CURRENT WIFI DISCONNECTS" "")
    (check (string= (read-native-control-file "@helper_capture@")
                    (format nil "test net~%secret!9~%"))
           "Wi-Fi runtime changed the exact helper stdin bytes")
    (exercise-wifi-helper
     "@helper_failure_fixture@" nil "WIFI PROFILE WAS NOT SAVED" "secret!9"))
  (check (= (retrodeck.native:canvas-clear #x121212) 1) "Canvas clear callback did not accept one argument")
  (check (= (retrodeck.native:canvas-draw-glyph -4 8 65 2 #xfe6c27) 1) "Canvas glyph callback did not accept five arguments")
  (check (= (retrodeck.native:canvas-draw-glyph 0 0 255 1 0) 1) "Canvas glyph callback rejected byte 255")
  (check (zerop (retrodeck.native:canvas-draw-glyph 0 0 256 1 0)) "Canvas glyph callback accepted a non-byte character")
  (check (zerop (retrodeck.native:canvas-draw-glyph 0 0 65 0 0)) "Canvas glyph callback accepted a zero scale")
  (check (= (retrodeck.native:canvas-fill-rect -4 8 12 16 #xfe6c27) 1) "Canvas rectangle callback did not accept five arguments")
  (check (signals-p type-error
           (fill-canvas-rect #x80000000 0 1 1 0)) "Canvas x coordinate exceeded the native signed range")
  (check (signals-p type-error
           (fill-canvas-rect 0 0 #x100000000 1 0)) "Canvas width exceeded the native unsigned range")
  (dolist (fixture '((:ready 0 #x562ba370a3b4da05)
                     (:running 123 #x802225e33aea53b5)
                     (:stopped 1000 #x171e4a78d40d458d)
                     (:stopped 1003 #x0171d3938f410bd5)
                     (:stopped 9999 #xd8877f2ba172c415)))
    (destructuring-bind (mode displayed expected) fixture
      (check (render-ten-seconds (list :mode mode :displayed displayed))
             "10 Seconds render failed for ~S/~D" mode displayed)
      (check (= (canvas-rgb565-hash) expected)
             "10 Seconds frame mismatch for ~S/~D" mode displayed)))
  (check (render-chiptune
          (make-chiptune-render-state
           :ready t :title "crazy" :system "ogg vorbis"
           :position 0 :length 50000 :file-count 1 :track-count 1 :volume 42))
         "Chiptune renderer failed")
  (check (= (canvas-rgb565-hash) #xb3f8e405ba8146cd)
         "Chiptune frame mismatch")
  (let ((metadata (open-chiptune-file "@chiptune@"))
        visual position)
    (check (equal metadata
                  '(:title "crazy" :subtitle "" :system "OGG VORBIS"
                    :length 50851 :track-index 0 :track-count 1))
           "Ogg metadata changed: ~S" metadata)
    (dotimes (block 4)
      (multiple-value-bind (next-visual ended frames next-position)
          (step-chiptune-file)
        (check (and next-visual (not ended) (= frames 735)
                    (plusp next-position))
               "Ogg block ~D changed" block)
        (setf visual next-visual position next-position)))
    (check (render-chiptune
            (apply #'make-chiptune-render-state
                   (append (list :ready t :position position :file-count 1
                                 :volume 42 :visual visual)
                           metadata)))
           "Decoded Ogg chiptune renderer failed")
    (check (= (canvas-rgb565-hash) #xe58bd71b6bd7e1cd)
           "Decoded Ogg chiptune frame mismatch")
    (check (rewind-chiptune-file) "Ogg rewind failed")
    (multiple-value-bind (rewound-visual ended frames rewound-position)
        (step-chiptune-file)
      (declare (ignore rewound-visual))
      (check (and (not ended) (= frames 735) (plusp rewound-position)
                  (< rewound-position position))
             "Ogg rewind position changed"))
    (check (close-chiptune-file) "Ogg close failed"))
  (let ((credits (read-bounded-regular-file "@credits@" 1 32768)))
    (check (and credits (search "FCEUmm" credits)) "Bounded regular-file callback did not read credits"))
  (check (not (read-bounded-regular-file "/no/such/retrodeck-credits.tsv" 1 32768)) "Missing regular file unexpectedly loaded")
  (check (not (retrodeck.native:read-regular-file "@credits@" 1 4194305)) "Regular-file callback accepted an oversized bound")
  (let ((path (concatenate 'string "@state_file@" ".control")))
    (check (string= (read-native-control-file path) (format nil "12~%")) "Control-file callback did not read exact bytes")
    (check (write-native-control-file path (format nil "7~%")) "Control-file callback did not write exact bytes")
    (check (string= (read-native-control-file path) (format nil "7~%")) "Control-file callback did not truncate the fixture"))
    (let ((device-path
            (concatenate 'string "@state_file@" ".brightness"))
          (maximum-path
            (concatenate 'string "@state_file@" ".brightness-max"))
          (state-path
            (concatenate 'string "@state_file@" ".brightness-state")))
      (multiple-value-bind (percent maximum)
          (load-dashboard-brightness device-path maximum-path state-path)
        (check (and (= percent 60) (= maximum 20))
               "Missing brightness state did not adopt hardware"))
      (check-native-state-file state-path (format nil "60~%") "Missing brightness state did not become canonical")
      (check (write-native-state-file state-path (format nil "70~%")) "Existing brightness fixture write failed")
      (multiple-value-bind (percent maximum)
          (load-dashboard-brightness device-path maximum-path state-path)
        (check (and (= percent 70) (= maximum 20)
                    (string= (read-native-control-file device-path)
                             (format nil "14~%"))) "Existing brightness state did not apply to hardware"))
      (check (write-native-state-file state-path (format nil "05~%")) "Malformed brightness fixture write failed")
      (check (signals-p error
               (load-dashboard-brightness
                device-path maximum-path state-path)) "Malformed brightness state was accepted")
      (multiple-value-bind (value present-p)
          (read-native-state-file state-path)
        (check (and present-p (string= value (format nil "05~%"))
                    (string= (read-native-control-file device-path)
                             (format nil "14~%"))) "Malformed brightness state was not preserved"))
      (let* ((state (dashboard-loop-initial-state nil :brightness 60))
             (runtime (make-dashboard-runtime))
             (plan (settings-activation-plan
                    (getf state :settings) :brightness-up)))
        (setf (getf runtime :brightness-maximum) 20
              (getf plan :device-path) device-path
              (getf plan :state-path) state-path)
        (check (equal (dashboard-runtime-handle-effect
                       runtime (list :settings-action plan) state)
                      '(:settings-result :succeeded-p t)) "Brightness settings effect did not save through Lisp")
        (multiple-value-bind (value present-p)
            (read-native-state-file state-path)
          (check (and present-p (string= value (format nil "70~%"))
                      (string= (read-native-control-file device-path)
                               (format nil "14~%"))) "Brightness settings effect wrote incorrect bytes"))))
    (let ((path "@state_file@"))
      (check-native-state-file path nil "Missing state file crossed the native boundary incorrectly")
      (check (= (load-dashboard-volume-state path 37) 37) "Missing volume state did not initialize from Lisp policy")
      (check-native-state-file path (format nil "37~%") "Missing volume state did not become canonical")
      (check (write-native-state-file path "37") "Exact state write failed")
      (check-native-state-file path "37" "Exact state read appended bytes")
      (check (write-native-state-file path (format nil "on~%")) "Legacy on fixture write failed")
      (check (= (load-dashboard-volume-state path 42) 42) "Legacy on volume did not migrate")
      (check (write-native-state-file path (format nil "off~%")) "Legacy off fixture write failed")
      (check (= (load-dashboard-volume-state path 42) 0) "Legacy off volume did not migrate")
      (check (= (parse-dashboard-volume-state (format nil "100~%")) 100) "Canonical volume parser failed")
      (check (signals-p error
               (parse-dashboard-volume-state (format nil "042~%"))) "Noncanonical volume parser input succeeded")
      (let* ((state (dashboard-loop-initial-state nil :volume 42))
             (runtime (make-dashboard-runtime :volume-state path))
             (plan (settings-activation-plan
                    (getf state :settings) :volume-down)))
        (check (and (zerop (dashboard-inherited-volume))
                    (zerop (getf runtime :default-volume))) "Inherited volume environment did not stay in Lisp policy")
        (setf (getf plan :path) path)
        (check (equal (dashboard-runtime-handle-effect
                       runtime (list :settings-action plan) state)
                      '(:settings-result :succeeded-p t)) "Volume settings effect did not save through Lisp")
        (check (write-native-state-file path (format nil "55~%")) "Child volume fixture write failed")
        (check (equal (dashboard-runtime-handle-effect
                       runtime '(:reload-volume) state)
                      '(:child-complete :volume 55)) "Child volume reload did not complete through Lisp")
        (check (write-native-state-file path (format nil "on~%")) "Child legacy volume fixture write failed")
        (let ((*error-output* (make-broadcast-stream)))
          (check (equal (dashboard-runtime-handle-effect
                         runtime '(:reload-volume) state)
                        '(:child-complete :volume 0)) "Child legacy volume lost the startup default"))))
    (let ((path (concatenate 'string "@state_file@" ".keymap")))
      (check-native-state-file path nil "Missing keymap state crossed the native boundary incorrectly")
      (check (string= (load-dashboard-keymap-state path) "us") "Missing keymap state did not default in Lisp policy")
      (check-native-state-file path (format nil "us~%") "Missing keymap state did not become canonical")
      (check (write-native-state-file path (format nil "cz~%")) "Czech keymap fixture write failed")
      (check (string= (load-dashboard-keymap-state path) "cz") "Czech keymap state did not load")
      (check (write-native-state-file path (format nil "de~%")) "Malformed keymap fixture write failed")
      (check (signals-p error
               (load-dashboard-keymap-state path)) "Malformed keymap state was accepted")
      (check-native-state-file path (format nil "de~%") "Malformed keymap state was not preserved")
      (check (write-native-state-file path (format nil "us~%")) "US keymap fixture write failed")
      (let* ((state (dashboard-loop-initial-state nil :keymap "us"))
             (runtime (make-dashboard-runtime :keymap-state path))
             (plan (settings-activation-plan
                    (getf state :settings) :keymap)))
        (setf (getf plan :path) path)
        (check (equal (dashboard-runtime-handle-effect
                       runtime (list :settings-action plan) state)
                      '(:settings-result :succeeded-p t)) "Keymap settings effect did not save through Lisp")
        (check-native-state-file path (format nil "cz~%") "Keymap settings effect did not write canonical bytes")))
    (let ((network (read-native-network-status "@wifi_status@")))
      (check (and (every #'stringp
                         (list (getf network :ssid)
                               (getf network :wlan-ipv4)
                               (getf network :wireguard-ipv4)
                               (getf network :selector)))
                  (string= (getf network :selector) "CONNECTED")) "Network status crossed the native boundary incorrectly"))
    (let ((mask (load-text-mask "HHHHHHHHHH" 4)))
      (check mask "Projected text mask callback did not load text")
      (check (configure-text-projection
              1000 1 20 4044 420 4000 56 72 104 210 480 #xffffaf) "Projected text callback rejected reference geometry")
      (check (draw-projected-text mask 0) "Projected text callback rejected its mask"))
    (check (clear-text-mask-cache) "Projected text mask cache did not clear")
    (check (zerop (retrodeck.native:canvas-draw-projected-text 1 0)) "Cleared projected text mask remained available")
    (let* ((credits (load-project-credits "@credits@"))
           (crawl (make-project-credits-crawl credits)))
      (prepare-project-credits-crawl crawl)
      (dolist (fixture '((nil 0 #x94ebf079be6e596b)
                         (nil 2000 #x1f14f6b786549363)
                         (nil 20000 #xad056a8a3c09508d)
                         (nil 600000000 #x8b13f64422d79712)
                         (t 0 #x7ac515855ccedc6b)
                         (t 60000 #x7ac515855ccedc6b)))
        (destructuring-bind (reduced-motion elapsed-ms expected) fixture
          (check (equal (render-project-credits
                         crawl reduced-motion elapsed-ms)
                        '(:close (1212 12 56 56))) "Credits layout crossed the native boundary incorrectly")
          (check (= (canvas-rgb565-hash) expected) "Credits frame mismatch at ~D ms" elapsed-ms)))
      (clear-credits-text-mask-cache))
    (let ((network '(:ssid "net1" :wlan-ipv4 "10.249.110.248"
                     :wireguard-ipv4 "10.0.0.10" :selector "CONNECTED")))
      (dolist (fixture
               '((42 60 "us" :volume-down "" #xfe85a35360bbf73b)
                 (0 60 "us" :volume-up "" #x7644b2469ecb1afb)
                 (42 100 "us" :brightness-up "" #x077200d78793022f)
                 (42 60 "cz" :keymap "" #xa36aed65b8604ddb)
                 (42 60 "us" :wifi "" #x455946051c5fa1eb)
                 (42 60 "us" :terminal "" #xc2cf74bde65d4213)
                 (42 60 "us" :volume-down
                  "VOLUME SAVED; CONFIRMATION TONE FAILED"
                  #xaf8cc58594a5a6fb)
                 (42 60 "us" :volume-down
                  "THIS SETTINGS STATUS FIXTURE IS INTENTIONALLY LONG ENOUGH TO USE THE SMALL FOOTER SCALE ACROSS THE COMPLETE DISPLAY"
                  #x03c80604a047bcfb)))
        (destructuring-bind
            (volume brightness keymap selected status expected) fixture
          (check (equal (render-dashboard-settings
                         volume brightness keymap selected status network)
                        '(:close (1212 12 56 56)
                          :wifi (926 20 262 108)
                          :volume-down (108 208 104 104)
                          :volume-up (228 208 104 104)
                          :brightness-down (438 208 104 104)
                          :brightness-up (558 208 104 104)
                          :terminal (792 208 112 104)
                          :keymap (1036 208 112 104))) "Settings layout crossed the native boundary incorrectly")
          (check (= (canvas-rgb565-hash) expected) "Settings frame mismatch for ~S" selected))))
    (dolist (fixture
             '(("" "" :ssid nil nil 30 #\q #\- #xd6be2f43c4faf0e6)
               ("" "" :ssid t nil 30 #\Q #\- #x7682dc83b0062730)
               ("NETWORK" "password" :passphrase t nil
                30 #\Q #\- #xa5c18f4c41654088)
               ("NETWORK" "password" :passphrase nil t
                42 #\1 #\> #xf919741f85fe2c31)))
      (destructuring-bind
          (ssid passphrase field uppercase symbols
           key-count first-key last-key expected)
          fixture
        (let* ((network '(:ssid "net1" :wlan-ipv4 "10.249.110.248"
                          :wireguard-ipv4 "10.0.0.10"
                          :selector "CONNECTED"))
               (state (wifi-initial-state
                       :ssid ssid :passphrase passphrase :field field
                       :uppercase uppercase :symbols symbols))
               (layout (render-dashboard-wifi state network))
               (keys (getf layout :keys)))
          (check (and
                  (equal (subseq layout 0 16)
                         '(:back (16 10 120 62)
                           :ssid (330 10 310 62)
                           :passphrase (650 10 330 62)
                           :save (990 10 274 62)
                           :mode (16 364 152 66)
                           :shift (176 364 168 66)
                           :space (352 364 700 66)
                           :delete (1060 364 204 66)))
                  (= (length keys) key-count)
                  (char= (second (first keys)) first-key)
                  (char= (second (car (last keys))) last-key)) "Wi-Fi layout crossed the native boundary incorrectly")
          (check (= (canvas-rgb565-hash) expected) "Wi-Fi frame mismatch for ~S/~S"
                 field (if symbols :symbols (if uppercase :uppercase :lowercase))))))
    (let ((plan (terminal-fixture-plan)))
      (check (string= (dashboard-terminal-starting-status plan) "STARTING TERMINAL")
             "Terminal starting status changed")
      (let ((result (run-dashboard-terminal plan)))
        (check (equal result
                      '(:started t :exited-for-touch nil
                        :exit-code 0 :signal nil :error nil
                        :shutdown-requested nil))
               "Terminal process callback result changed: ~S" result)
        (check (string= (dashboard-terminal-result-status plan result) "TERMINAL EXITED")
               "Terminal return status changed")))
    (dolist (fixture '(("failure" :exit-code 7
                         "TERMINAL EXITED (STATUS 7)")
                       ("signal" :signal 15
                         "TERMINAL STOPPED (SIGNAL 15)")))
      (destructuring-bind (mode field expected-value expected-status) fixture
        (let* ((plan (terminal-fixture-plan "@terminal_fixture@" (list mode)))
               (result (run-dashboard-terminal plan)))
          (check (and (eql (getf result field) expected-value)
                      (string= (dashboard-terminal-result-status plan result)
                               expected-status)) "Terminal ~A result changed: ~S" mode result))))
    (let* ((plan (terminal-fixture-plan "/no/such/retrodeck-terminal"))
           (result (run-dashboard-terminal plan)))
      (check (and (not (getf result :started))
                  (stringp (getf result :error))
                  (string= (dashboard-terminal-result-status plan result)
                           "TERMINAL ERROR - CHECK LOG")) "Terminal exec failure result changed: ~S" result))
    (let ((native-result
            (retrodeck.native:run-child
             (native-path-string "@child_fixture@")
             (list (coerce "clean" 'base-string)
                   (coerce "second argument" 'base-string))
             (list (cons (coerce "RETRODECK_ALPHA" 'base-string)
                         (coerce "alpha value" 'base-string))
                   (cons (coerce "RETRODECK_BETA" 'base-string)
                         (coerce "beta" 'base-string)))
             (coerce "child fixture" 'base-string) 0)))
      (check (equal native-result '(1 0 0 -1 nil 0)) "Generic child callback result changed: ~S" native-result))
    (dolist (native-result
             (list
              (retrodeck.native:run-child
               (native-path-string "@child_fixture@")
               (coerce "not a list" 'base-string) nil
               (coerce "child fixture" 'base-string) 0)
              (retrodeck.native:run-child
               (native-path-string "@child_fixture@") nil
               (list (coerce "not a pair" 'base-string))
               (coerce "child fixture" 'base-string) 0)))
      (check (and (= (length native-result) 6)
                  (zerop (first native-result))
                  (stringp (fifth native-result))
                  (zerop (sixth native-result)))
             "Malformed child lists escaped native validation: ~S" native-result))
    (dolist (fixture '(("clean" :exit-code 0)
                       ("failure" :exit-code 7)
                       ("signal" :signal 15)))
      (destructuring-bind (mode field expected) fixture
        (let* ((plan (list :executable "@child_fixture@"
                           :arguments (list mode "second argument")
                           :environment
                           '(("RETRODECK_ALPHA" . "alpha value")
                             ("RETRODECK_BETA" . "beta"))
                           :label "child fixture"
                           :touch-supervision nil
                           :mirror-console nil))
               (result (run-dashboard-child plan)))
          (check (and (eql (getf result field) expected)
                      (not (getf result :shutdown-requested))) "Generic child ~A result changed: ~S" mode result))))
    (let* ((plan '(:executable "/no/such/retrodeck-child"
                   :arguments nil :environment nil :label "missing child"
                   :touch-supervision nil :mirror-console nil))
           (result (run-dashboard-child plan)))
      (check (and (not (getf result :started))
                  (stringp (getf result :error))
                  (not (getf result :shutdown-requested))) "Generic child exec failure result changed: ~S" result))
    (labels ((exercise-launch (kind plan)
               (let ((state (dashboard-loop-initial-state nil))
                     (runtime (make-dashboard-runtime :wayland t)))
                 (setf (getf state :active-launch)
                       (list :kind kind :plan plan))
                 (let ((completion
                         (dashboard-runtime-handle-effect
                          runtime (list :launch plan) state)))
                   (unless (and (eq (first completion) :child-returned)
                                (eql (getf (getf (rest completion) :result) :exit-code)
                                     0))
                     (error "No-handler ~A launch changed: ~S"
                            kind completion))))))
      (exercise-launch
       :game
       '(:executable "@child_fixture@"
         :arguments ("clean" "second argument")
         :environment (("RETRODECK_ALPHA" . "alpha value")
                       ("RETRODECK_BETA" . "beta"))
         :label "child fixture" :touch-supervision nil :mirror-console nil))
      (exercise-launch
       :reboot
       '(:executable "@reboot_fixture@" :arguments nil :environment nil
         :label "reboot" :touch-supervision t :mirror-console nil))
      (exercise-launch :terminal (terminal-fixture-plan)))
    (let ((icon (load-png-raster "@settings_icon@" 23 23)))
      (check icon "PNG raster callback did not load the settings asset")
      (check (draw-canvas-raster icon 3 5 50 50) "Canvas raster callback did not accept five arguments"))
    (let ((cover (load-cover-raster "@settings_icon@" #x5f87ff)))
      (check cover "Cover raster callback did not load a PNG")
      (check (draw-canvas-raster cover 60 5 50 50) "Cover raster did not draw"))
    (check (clear-dashboard-raster-cache) "Native raster cache did not clear")
    (check (not (load-png-raster "/no/such/retrodeck-raster.png" 23 23)) "Missing PNG raster unexpectedly loaded")
    (retrodeck.native:evdev-controls-close)
    (unless (and (null (retrodeck.native:evdev-next-control))
                 (equal (retrodeck.native:evdev-controls-dispatch 0) '(0 0)))
      (error "Closed evdev controls crossed the native boundary incorrectly"))
    (let ((counts (retrodeck.native:evdev-controls-scan)))
      (when counts
        (unless (and (= (length counts) 2)
                     (<= 0 (first counts) 2)
                     (<= 0 (second counts) 4))
          (error "Evdev control scan crossed the native boundary incorrectly"))))
    (retrodeck.native:evdev-controls-close)
    (unless (and (equal (dashboard-control-actions
                         '(:kind :keyboard :code 15
                           :shift t :repeat nil))
                        '(:system-previous))
                 (equal (dashboard-control-actions
                         '(:kind :gamepad :edges #x224))
                        '(:confirm :system-next :right))
                 (eq (dashboard-controller-command
                      '(:system-next :confirm) nil nil)
                     :system-next)
                 (dashboard-controller-scan-due-p 0 999))
      (error "Controller policy failed under target ECL"))
    (multiple-value-bind (guard accepted suspended)
        (dashboard-controller-guard-accept-edge
         (dashboard-controller-guard-initial-state) 10)
      (unless (and accepted (not suspended)
                   (equal (getf guard :edge-times) '(10)))
        (error "Controller guard failed under target ECL")))
    (unless (and (null (retrodeck.native:evdev-next-touch))
                 (= (retrodeck.native:evdev-touch-dispatch 0) -1))
      (error "Closed evdev touch state crossed the native boundary incorrectly"))
    (retrodeck.native:evdev-touch-close)
    (check (equal (retrodeck.native:input-poll 0 0) '(0 0 0 0 0 0 0)) "Empty aggregate input poll crossed the native boundary incorrectly")
    (unless (equal (poll-native-input nil 0)
                   '(:poll-ready-p nil :control-count 0 :touch-count 0
                     :touch-lost-p nil :rescan-controls-p nil :shutdown-p nil
                     :refresh-p nil))
      (error "Aggregate input poll did not normalize under target ECL"))
    (when (retrodeck.native:input-poll 1 0)
      (error "Closed Wayland input unexpectedly produced a snapshot"))
    (when (retrodeck.native:input-poll 2 0)
      (error "Aggregate input poll accepted an invalid backend"))
    (check (null (retrodeck.native:fbdev-size)) "Closed fbdev state crossed the native boundary incorrectly")
  (check (zerop (retrodeck.native:fbdev-present-canvas)) "Closed fbdev canvas presentation succeeded")
  (check (zerop (retrodeck.native:fbdev-present-solid 0)) "fbdev solid callback did not accept one argument")
  (retrodeck.native:fbdev-close)
  (unless (and (null (retrodeck.native:wayland-size))
               (null (retrodeck.native:wayland-next-touch))
               (zerop (retrodeck.native:wayland-shutdown-p)))
    (error "Closed Wayland state crossed the native boundary incorrectly"))
  (check (zerop (retrodeck.native:wayland-present-canvas)) "Closed Wayland canvas presentation succeeded")
  (check (zerop (retrodeck.native:wayland-present-solid 0)) "Wayland solid callback did not accept one argument")
  (check (= (retrodeck.native:wayland-dispatch 0) -1) "Wayland dispatch callback did not accept one argument")
  (retrodeck.native:wayland-close)
  (check (= (retrodeck.native:play-tones 659 25 0 0 0) 0) "Invalid audio request crossed the native boundary")
  (check (play-menu-sound :confirm 42) "Native audio worker did not start")
  (check (menu-sound-blocks-input-p :controller) "Controller quarantine was not active")
  (check (not (menu-sound-blocks-input-p :touch)) "Menu sound blocked touch")
  (stop-menu-sound)
  (check (= (retrodeck.native:audio-active-p) 0) "Native audio worker did not stop")
  (finish-menu-sound)
  0)
